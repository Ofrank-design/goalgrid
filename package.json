{
  "name": "goalgrid",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "tsx --test tests/*.test.ts tests/golden/*.test.ts",
    "scan": "tsx scripts/scan-secrets.ts",
    "check-env": "node --env-file=.env.local --import tsx scripts/check-env.ts",
    "loadtest": "tsx scripts/loadtest.ts",
    "backtest": "tsx scripts/backtest.ts",
    "test:db": "bash supabase/tests/run.sh",
    "smoke": "tsx scripts/smoke.ts",
    "probe": "node --env-file=.env.local --import tsx scripts/probe-providers.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.0",
    "next": "^16.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.1"
  }
}
