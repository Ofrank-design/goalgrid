RESEND_API_KEY=
GOALGRID_ALLOW_CRESTS=true
ODDS_DAILY_CREDIT_BUDGET=16
# Rolling 24 hour credit budget per paid provider, shared across instances. 0 removes a cap. Defaults: odds-api 16, serpapi 3, newsapi 90, others uncapped.
# PROVIDER_BUDGET_SPORTMONKS=
# PROVIDER_BUDGET_SERPAPI=
# PROVIDER_BUDGET_NEWSAPI=
CRON_SECRET=
BLOCKED_TERMS=
ADMIN_EMAILS=
SITE_URL=
EMAIL_FROM=
EMAIL_SECRET=
EMAIL_DAILY_CAP=90
CONTACT_TO=
ENABLE_SIM_ADDENDUM=false
# GoalGrid resource governance
GOALGRID_SIM_DEFAULT_ITERATIONS=1
GOALGRID_SIM_MAX_ITERATIONS=1000
GOALGRID_SIM_MAX_CONCURRENT=2
GOALGRID_SIM_MAX_RUNTIME_MS=30000
GOALGRID_SIM_RETENTION_DAYS=30
GOALGRID_SIM_MULTI_PRO=1000
GOALGRID_SIM_MULTI_PREMIUM=1000
GOALGRID_SIM_SEASON_PRO=200
GOALGRID_SIM_SEASON_PREMIUM=1000
GOALGRID_POSTS_PER_HOUR=20
GOALGRID_COMMENTS_PER_HOUR=20
GOALGRID_LIKES_PER_HOUR=60
GOALGRID_REPORTS_PER_DAY=10
GOALGRID_FOLLOWS_PER_HOUR=30
GOALGRID_MAX_POST_LENGTH=500
GOALGRID_MAX_FILES_PER_POST=2
GOALGRID_AI_REQUESTS_PER_HOUR=10
GOALGRID_AI_TOKENS_PER_HOUR=120000
GOALGRID_AI_MAX_OUTPUT_TOKENS=2500
GOALGRID_UPLOAD_MAX_BYTES=1000000
GOALGRID_UPLOAD_MAX_FILES=2
GOALGRID_MAX_JOB_DURATION_MS=60000
GOALGRID_MAX_QUEUE_DEPTH=1000
NOTIFICATION_EMAIL_BATCH=40

# Trigger.dev secret key. Set it in your hosting environment only. Never commit a real key.
TRIGGER_SECRET_KEY=

# Model resource governance
GOALGRID_MODEL_CANDIDATE_MAX=30
GOALGRID_MODEL_ACTIVE_MAX=15

# Rate limiting. TRUSTED_PROXY_HOPS = number of proxies in front of the app when NOT on Vercel (default 1). RATE_LIMIT_SALT makes stored limiter keys unguessable.
# TRUSTED_PROXY_HOPS=1
RATE_LIMIT_SALT=

# Freshness bound for stored predictions (minutes). Default 1560 (26h) suits one refresh a day on Vercel Hobby; use 45 if you refresh every 15 minutes.
# STORED_PREDICTION_MAX_AGE_MINUTES=1560
